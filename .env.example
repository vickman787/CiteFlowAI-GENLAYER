# Supabase — a fresh project, not shared with the main CiteFlowAI app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Circle Programmable Wallets (user-controlled) — Arc Testnet
NEXT_PUBLIC_CIRCLE_APP_ID=
CIRCLE_API_KEY=
CIRCLE_WALLET_ID=
RAW_ENTITY_SECRET=
AGENT_TREASURY_ADDRESS=

# Gemini — used for retrieval embeddings (query/document vectors), not for
# generating the final answer. Generation itself runs through GenLayer.
GEMINI_API_KEY=

# GenLayer — the Intelligent Contract that performs the actual "AI aspect":
# reading the retrieved source chunks and producing a grounded, cited answer.
# No raw RPC URL needed — genlayer-js ships named chain presets with the
# endpoint baked in. Using studionet (GenLayer's hosted Studio network,
# matches the studio.genlayer.com deploy flow) since testnetBradbury was
# unreliable when this was set up. See src/lib/genlayer/client.ts.
GENLAYER_NETWORK=studionet
GENLAYER_RELAYER_PRIVATE_KEY=
GENLAYER_CONTRACT_ADDRESS=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only HMAC key used to sign payment receipts.
RECEIPT_SIGNING_SECRET=
